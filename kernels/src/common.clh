#define P1 1056440321u
#define Q1 3238526977u
#define P2 1053818881u
#define Q2 3241148417u
#define P3 1051721729u
#define Q3 3243245569u
#define NORM1 1056436291u
#define NORM2 1053814861u
#define RSQ1 596300470u
#define IM1 160598537u
#define MFIM1 350572486u
#define SQRTI1 574280268u
#define ISQRTI1 986507723u
#define RSQ2 159648582u
